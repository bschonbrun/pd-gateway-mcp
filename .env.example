# ── Pipedream REST API (workflow management) ─────────────────────────
PIPEDREAM_API_KEY=your_api_key_here

# ── Pipedream Connect API (app action execution) ─────────────────────
PIPEDREAM_CLIENT_ID=your_client_id_here
PIPEDREAM_CLIENT_SECRET=your_client_secret_here
PIPEDREAM_PROJECT_ID=your_project_id_here   # proj_xxxxx

# ── Pipedream workspace (optional) ───────────────────────────────────
PIPEDREAM_ORG_ID=your_org_id_here           # org_xxxxx — omit if using personal workspace
PIPEDREAM_EXTERNAL_USER_ID=your_user_id     # identity key for Connect API; defaults to "pd-gateway-mcp"

# ── Pipedream environment ─────────────────────────────────────────────
# Set to "production" for live deployments. Defaults to "development".
PIPEDREAM_ENVIRONMENT=development

# ── Supabase (digest data source) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── Digest: Slack ─────────────────────────────────────────────────────
SLACK_AUTH_PROVISION_ID=apn_xxxxxxx         # Pipedream Slack app provision ID
SLACK_DIGEST_CHANNEL=C0000000000            # Slack channel ID

# ── Digest: Email (Outlook) ───────────────────────────────────────────
OUTLOOK_AUTH_PROVISION_ID=apn_xxxxxxx       # Pipedream Outlook provision ID
DIGEST_EMAIL_RECIPIENTS=user@example.com,user2@example.com
DIGEST_EMAIL_SUBJECT=Daily Revenue Tracker  # Optional subject prefix

# ── Digest: WhatsApp (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx  # Your Twilio WhatsApp sender number
DIGEST_WHATSAPP_RECIPIENTS=+16045551234,+16045555678
DIGEST_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Twilio content template SID
DIGEST_WA_DELAY_MS=15000                    # Delay between template and freeform message (ms)

# ── Digest: scheduling ────────────────────────────────────────────────
DIGEST_CHANNELS=slack,email,whatsapp        # Channels for standalone cron runner
DIGEST_DRY_RUN=false                        # Set to "true" to preview without sending
DIGEST_WEBHOOK_URL=https://your-api.example.com/digest  # Webhook for deploy_template_workflow

# ── Anthropic (ask_claude tool) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
